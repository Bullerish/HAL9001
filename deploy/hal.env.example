# HAL9001 environment — copy this to /etc/hal9001/hal.env on the server,
# fill in REAL values, then: chmod 600 /etc/hal9001/hal.env
#
# NEVER commit the real file. This .example (placeholders only) is the only one in git.

# Required — the LLM key the hive thinks with (this is what burns tokens).
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Required — the shared hive store (identity, events, journal, race records, donations).
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=REPLACE_ME

# Optional — ambient pace. "slow" (~6x slower) keeps a 24/7 box cheap. 1 = snappy demo pace.
# NOTE this throttles the paid/LLM cadence. The free grinder below is NOT paced by it, because free
# work costs no tokens and there is no reason to make the hive sit idle.
HAL_PACE=slow

# Optional — the FREE grinder: continuous LLM-free derivation on the small sizes, so the hive is never
# idle between races and the live page always has real work to print. Costs $0 (CPU only) and runs
# whether or not anyone has paid. Leader-only and duty-cycled: GRIND_SECS of work, then REST_SECS off,
# so a small box keeps a core free to serve the page. Set HAL_GRIND=off to disable entirely.
HAL_GRIND=on
HAL_GRIND_SECS=6
HAL_GRIND_REST_SECS=3

# Optional but IMPORTANT for a headless box — turn on AUTONOMOUS mode (the hive self-drives: matmul
# race, self-set goals, gap-filling, journaling). Without this the box only acts on visitor requests,
# the "matrices being worked" panel goes stale, and self-set goals stay stuck at "Proposed". There is
# no console on the box, so this env is the only way to enable it there. on/off (default: leave as-is).
HAL_AUTONOMOUS=on

# Optional — how this node reports itself in the dashboard's LIVE node count. "core" = part of the
# hal9001.io hive box; "volunteer" = remote donated compute. Defaults to "core" (leave unset on the box).
HAL_NODE_ROLE=core

# Optional — IDLE SELF-DRIVING (autonomous mode). How many HELPER nodes the hive keeps alive so the
# swarm stays a mesh that can cross-query continuously. DEFAULT 2, ceiling 5. Each node is a process
# on this box: raise it only if the box has the cores/RAM to spare. (Hired workers previously spawned
# but never joined the mesh — the parent never told its own transport about the port it had spawned.
# Fixed; `dotnet HAL9001.dll meshtest` proves a hired node joins.)
HAL_TARGET_NODES=2
# Optional — how often (seconds) the idle mesh runs a FREE cross-node search round: every peer searches
# the current ladder size from its own seed and reports back, and the leader re-verifies anything it is
# sent before adopting it. Costs NO tokens and needs no API key, so it runs even with the budget at 0.
HAL_PEERROUND_SECS=120
# ...and how long (seconds) each node searches per round before reporting. Keep it well under the round
# cadence so nodes are never all busy at once. Default 8.
HAL_PEERSEARCH_SECS=8
# Optional — how often (seconds) the idle mesh runs an LLM cross-node competition (the nodes deliberating
# in language). Default 300 (~5 min). This one SPENDS: it sits below the daily budget gate, so with
# HAL_DAILY_USD=0 it only happens after someone pays.
HAL_CROSSQUERY_SECS=300
# Optional — memory ceiling (MB) for ONE direct tensor-search attempt. The search declines any size/rank
# whose arrays would not fit, so it can never OOM the box. Default 256.
HAL_SEARCH_MEM_MB=256

# Optional — the biggest matrix size the ladder will climb to. The ladder itself has NO end: above the
# written-down rungs (2,3,4,8,16,32,64,128,256) it keeps doubling — 512, 1024, 2048, 4096... This is
# purely a resource limit, because a round costs ~8x more wall-clock per doubling. Measured on a dev
# box: 512 ≈ 13s/round, 1024 ≈ 90s/round, 2048 ≈ 7min/round. On a small 2-core VPS, 1024 keeps rounds
# comfortable; 2048 (the default) is fine if you want it grinding. It never declares itself "done" —
# at the top rung it keeps racing that size, and the small sizes keep getting side rounds.
HAL_MAX_SIZE=2048

# Optional — turn ON the donations endpoint (/api/donate). Leave UNSET to keep it disabled (404).
# Set a long random string; your Stripe webhook sends it in the X-HAL-Secret header.
# Generate one with:  openssl rand -hex 32
HAL_DONATE_SECRET=

# Daily FREE LLM allowance HAL may spend on YOUR Anthropic key with nobody paying. 0 = HAL never spends
# your usage on its own — no autonomous self-driving, no free visitor asks — it only thinks once a
# payment/donation ('fund' action) tops up today's budget. The free CPU work keeps running either way
# (it costs no Anthropic tokens): scheme composition, the tensor search, kernel autotuning, and the
# cross-node search rounds — i.e. the hive keeps improving at every ladder size on $0. Set this above 0
# only if you WANT to grant a free daily LLM allowance out of your own pocket.
HAL_DAILY_USD=0
# Token prices in USD per 1,000,000 tokens — SET THESE to match your model's current rate (they drift).
# Defaults are a Haiku-class ballpark; check Anthropic's pricing for your model.
HAL_PRICE_IN=1.0
HAL_PRICE_OUT=5.0

# Optional — number of FREE tokens each new visitor gets on first load (defaults to 0 — none).
# Visitors get nothing for free by default; set this >0 only to deliberately offer a free trial.
HAL_FREE_TOKENS=0

# ── Stripe token purchases (bite 24) ──────────────────────────────────────────────────────────────
# Both /api/checkout and /api/stripe-webhook stay OFF (404) until these are set.
# 1) Your Stripe secret/restricted key. The restricted key needs "Checkout Sessions: write".
#    rk_live_... for real money, rk_test_... for test mode. NEVER commit this.
STRIPE_SECRET_KEY=
# 2) The signing secret of the webhook endpoint you create in the Stripe dashboard, pointed at
#    https://hal9001.io/api/stripe-webhook and subscribed to "checkout.session.completed".
#    Stripe shows it as whsec_...  — this is what verifies that callbacks really came from Stripe.
STRIPE_WEBHOOK_SECRET=
# Optional — public base URL used for Stripe success/cancel redirects (defaults to https://hal9001.io).
HAL_PUBLIC_URL=https://hal9001.io

