[Unit]
Description=HAL9001 dashboard (read-only web UI over the hive)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hal
Group=hal
WorkingDirectory=/opt/hal9001
EnvironmentFile=/etc/hal9001/hal.env
# Serves the HAL 9001 page + JSON API on localhost:8765; Caddy fronts it with TLS.
ExecStart=/opt/hal9001/HAL9001 dashboard 8765
StandardInput=null
Restart=always
RestartSec=5

# The page is the thing that must stay up, so it gets its own guaranteed slice and a ceiling well below
# the swarm's — it should never be the process that dies, and it should never be what kills the box.
MemoryAccounting=yes
MemoryMax=15%
MemoryHigh=10%
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
